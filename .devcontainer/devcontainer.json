{
  "name": "ghcp-ttt",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": false
    },
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14",
      "installTools": false
    }
  },
  "postCreateCommand": "npm install -g @marp-team/marp-cli markdownlint-cli2 && cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit .devcontainer/check-toolchains.sh && .devcontainer/check-toolchains.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "marp-team.marp-vscode",
        "DavidAnson.vscode-markdownlint",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "vscjava.vscode-java-pack",
        "ms-dotnettools.csharp",
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "markdown.marp.enableHtml": true,
        "python.defaultInterpreterPath": "/usr/local/python/current/bin/python",
        "markdownlint.config": {
          "extends": ".markdownlint.json"
        }
      }
    }
  }
}
