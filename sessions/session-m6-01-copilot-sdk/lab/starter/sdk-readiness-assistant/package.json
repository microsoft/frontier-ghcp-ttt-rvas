{
  "name": "sdk-readiness-assistant-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Starter change readiness assistant for the GitHub Copilot SDK lab",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test dist/tests/*.test.js",
    "demo": "tsx src/live-demo.ts"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.16"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
